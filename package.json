{
  "name": "slime-castle-card-generator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/site.mjs dev",
    "dev:demo": "node scripts/site.mjs demo",
    "emulators": "firebase emulators:start --project demo-slime-castle --only auth,firestore",
    "build": "node scripts/site.mjs build",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-slime-castle --only firestore \"node --test tests/rules/*.test.mjs\""
  },
  "dependencies": {
    "firebase": "^12.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.35.0"
  }
}
